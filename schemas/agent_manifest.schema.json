{
  "$defs": {
    "AgentEntry": {
      "additionalProperties": false,
      "properties": {
        "channels": {"items": {"type": "string"}, "title": "Channels", "type": "array"},
        "accepted_inputs": {"items": {"type": "string"}, "title": "Accepted Inputs", "type": "array"}
      },
      "title": "AgentEntry",
      "type": "object"
    },
    "AgentInstructions": {
      "additionalProperties": false,
      "properties": {
        "mission": {"minLength": 1, "title": "Mission", "type": "string"},
        "objectives": {"items": {"type": "string"}, "title": "Objectives", "type": "array"},
        "rules": {"items": {"type": "string"}, "title": "Rules", "type": "array"}
      },
      "required": ["mission"],
      "title": "AgentInstructions",
      "type": "object"
    },
    "AgentKnowledge": {
      "additionalProperties": false,
      "properties": {
        "canonical_sources": {"items": {"type": "string"}, "title": "Canonical Sources", "type": "array"},
        "retrieval_sources": {"items": {"type": "string"}, "title": "Retrieval Sources", "type": "array"},
        "external_content_trust": {"$ref": "#/$defs/ExternalContentTrust", "default": "untrusted"}
      },
      "title": "AgentKnowledge",
      "type": "object"
    },
    "AgentLimits": {
      "additionalProperties": false,
      "properties": {
        "prohibited_actions": {"items": {"type": "string"}, "title": "Prohibited Actions", "type": "array"},
        "approval_required": {"items": {"type": "string"}, "title": "Approval Required", "type": "array"},
        "timeout_seconds": {"anyOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}], "default": null, "title": "Timeout Seconds"},
        "budget": {"anyOf": [{"minimum": 0, "type": "number"}, {"type": "null"}], "default": null, "title": "Budget"},
        "rate_limit_per_minute": {"anyOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}], "default": null, "title": "Rate Limit Per Minute"}
      },
      "title": "AgentLimits",
      "type": "object"
    },
    "AgentToolGrant": {
      "additionalProperties": false,
      "properties": {
        "tool_id": {"minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$", "title": "Tool Id", "type": "string"},
        "scopes": {"items": {"type": "string"}, "title": "Scopes", "type": "array"},
        "read_only": {"default": true, "title": "Read Only", "type": "boolean"}
      },
      "required": ["tool_id"],
      "title": "AgentToolGrant",
      "type": "object"
    },
    "AgentTriggers": {
      "additionalProperties": false,
      "properties": {
        "events": {"items": {"type": "string"}, "title": "Events", "type": "array"},
        "schedules": {"items": {"type": "string"}, "title": "Schedules", "type": "array"},
        "conditions": {"items": {"type": "string"}, "title": "Conditions", "type": "array"}
      },
      "title": "AgentTriggers",
      "type": "object"
    },
    "ExternalContentTrust": {"enum": ["untrusted", "mixed", "trusted"], "title": "ExternalContentTrust", "type": "string"}
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {"minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$", "title": "Agent Id", "type": "string"},
    "version": {"minLength": 1, "title": "Version", "type": "string"},
    "project_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Project Id"},
    "owner": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Owner"},
    "entry": {"$ref": "#/$defs/AgentEntry"},
    "instructions": {"$ref": "#/$defs/AgentInstructions"},
    "knowledge": {"$ref": "#/$defs/AgentKnowledge"},
    "tools": {"items": {"$ref": "#/$defs/AgentToolGrant"}, "title": "Tools", "type": "array"},
    "triggers": {"$ref": "#/$defs/AgentTriggers"},
    "limits": {"$ref": "#/$defs/AgentLimits"}
  },
  "required": ["agent_id", "version", "entry", "instructions", "knowledge", "limits"],
  "title": "AgentManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED from contracts/manifests.py; do not edit manually."
}
