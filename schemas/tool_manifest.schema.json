{
  "$defs": {
    "ApprovalPolicy": {"enum": ["allow", "policy", "human", "deny"], "title": "ApprovalPolicy", "type": "string"},
    "CostClass": {"enum": ["free", "low", "medium", "high"], "title": "CostClass", "type": "string"},
    "RiskLevel": {"enum": ["low", "medium", "high", "critical"], "title": "RiskLevel", "type": "string"},
    "SideEffects": {"enum": ["none", "reversible", "external", "irreversible"], "title": "SideEffects", "type": "string"}
  },
  "additionalProperties": false,
  "properties": {
    "tool_id": {"minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$", "title": "Tool Id", "type": "string"},
    "version": {"minLength": 1, "title": "Version", "type": "string"},
    "owner": {"minLength": 1, "title": "Owner", "type": "string"},
    "project": {"minLength": 1, "title": "Project", "type": "string"},
    "read_only": {"title": "Read Only", "type": "boolean"},
    "side_effects": {"$ref": "#/$defs/SideEffects"},
    "required_scopes": {"items": {"type": "string"}, "title": "Required Scopes", "type": "array"},
    "risk_level": {"$ref": "#/$defs/RiskLevel"},
    "timeout_seconds": {"anyOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}], "default": null, "title": "Timeout Seconds"},
    "cost_class": {"anyOf": [{"$ref": "#/$defs/CostClass"}, {"type": "null"}], "default": null},
    "approval_policy": {"$ref": "#/$defs/ApprovalPolicy", "default": "policy"},
    "input_schema": {"additionalProperties": true, "title": "Input Schema", "type": "object"},
    "output_schema": {"additionalProperties": true, "title": "Output Schema", "type": "object"},
    "provenance_required": {"default": true, "title": "Provenance Required", "type": "boolean"}
  },
  "required": ["tool_id", "version", "owner", "project", "read_only", "side_effects", "risk_level"],
  "title": "ToolManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED from contracts/manifests.py; do not edit manually."
}
