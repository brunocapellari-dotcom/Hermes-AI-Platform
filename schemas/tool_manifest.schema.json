{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/tool_manifest.schema.json",
  "title": "Hermes Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_id", "version", "owner", "project", "read_only", "side_effects", "required_scopes", "risk_level", "input_schema", "output_schema"],
  "properties": {
    "tool_id": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$"},
    "version": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "read_only": {"type": "boolean"},
    "side_effects": {"type": "string", "enum": ["none", "reversible", "external", "irreversible"]},
    "required_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "timeout_seconds": {"type": ["integer", "null"], "minimum": 1},
    "cost_class": {"type": ["string", "null"], "enum": ["free", "low", "medium", "high", null]},
    "approval_policy": {"type": "string", "enum": ["allow", "policy", "human", "deny"]},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "provenance_required": {"type": "boolean", "default": true}
  }
}